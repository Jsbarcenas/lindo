{
  "expo": {
    "name": "Lindo Mobile",
    "slug": "lindo-mobile",
    "scheme": "lindo",
    "version": "0.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lindo.mobile"
    },
    "android": {
      "package": "com.lindo.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ]
  }
}
