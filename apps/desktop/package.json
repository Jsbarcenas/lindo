{
  "name": "@lindo/desktop",
  "productName": "Lindo",
  "private": true,
  "version": "1.0.0",
  "description": "Lindo Desktop Application",
  "homepage": "https://github.com/Jsbarcenas/lindo",
  "author": "Santiago Barcenas",
  "license": "GPL-3.0",
  "main": "dist/main/index.mjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/preload/tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "dev": "node scripts/watch.mjs",
    "smoke": "scripts/smoke.sh",
    "build": "node scripts/build.mjs && electron-builder --publish never && npm run verify:asar",
    "check:safe-storage": "electron scripts/safe-storage-check.cjs",
    "check:titlebar": "electron scripts/titlebar-check.cjs",
    "check:electron": "npm run check:safe-storage && npm run check:titlebar",
    "verify:asar": "node scripts/verify-asar.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^19.0.4",
    "argon2": "^0.45.1",
    "axios": "^0.27.2",
    "axios-retry": "^3.2.5",
    "compare-versions": "^6.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "custom-electron-titlebar": "^4.4.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "eventemitter3": "^4.0.7",
    "express": "^4.18.1",
    "fs-extra": "^10.1.0",
    "mobx": "^6.6.0",
    "mobx-state-tree": "^5.1.5",
    "object-hash": "^3.0.0",
    "typesafe-i18n": "^5.5.2",
    "uuid": "^8.3.2",
    "winston": "^3.8.1",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@lindo/i18n": "workspace:*",
    "@lindo/shared": "workspace:*",
    "@lindo/typescript-config": "workspace:*",
    "@lindo/ui": "workspace:*",
    "@lindo/updater-core": "workspace:*",
    "@types/cors": "^2.8.12",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.13",
    "@types/fs-extra": "^11.0.4",
    "@types/js-beautify": "^1.13.3",
    "@types/node": "^22.0.0",
    "@types/object-hash": "^2.2.1",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "~43.3.0",
    "electron-builder": "^26.15.7",
    "get-port": "^6.1.2",
    "js-beautify": "^1.14.3",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-router-dom": "6",
    "sass": "^1.51.0",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "env": {
    "VITE_DEV_SERVER_HOST": "127.0.0.1",
    "VITE_DEV_SERVER_PORT": 7777
  }
}
